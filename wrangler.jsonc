{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizverse",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "quizverse",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "quizverse-inc-cache",
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "quizverse-tag-cache",
      "database_id": "702abf4d-1738-4cf3-9821-c0a45d705708",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  // Fallback de rate limiting sin secretos cuando falta Upstash
  // (src/lib/utils/rate-limit.ts mapea cada política a su namespace).
  // `period` solo admite 10 u 60 s; las ventanas largas del código
  // (reportes/comentarios, 10 min) se aproximan a su ritmo por minuto.
  "ratelimits": [
    // Auth estricto por identificador (email hasheado / user id).
    { "name": "RATE_LIMIT_AUTH", "namespace_id": "7101", "simple": { "limit": 5, "period": 60 } },
    // Techo anti-spray por IP en acciones de auth.
    {
      "name": "RATE_LIMIT_AUTH_IP",
      "namespace_id": "7102",
      "simple": { "limit": 30, "period": 60 },
    },
    // Juego: crear quiz y generación con IA (por IP y por usuario).
    { "name": "RATE_LIMIT_GAME", "namespace_id": "7103", "simple": { "limit": 10, "period": 60 } },
    // Reveal por pregunta: 1-2 llamadas por pregunta jugada, por IP.
    {
      "name": "RATE_LIMIT_REVEAL",
      "namespace_id": "7104",
      "simple": { "limit": 120, "period": 60 },
    },
    // API general: monitor, analytics, perfil, follows, likes.
    { "name": "RATE_LIMIT_API", "namespace_id": "7105", "simple": { "limit": 100, "period": 60 } },
    // Escritura social: registro de shares, por IP.
    {
      "name": "RATE_LIMIT_SOCIAL",
      "namespace_id": "7106",
      "simple": { "limit": 30, "period": 60 },
    },
    // Seguir/dejar de seguir, por usuario (frena bucles de notificaciones).
    {
      "name": "RATE_LIMIT_FOLLOW",
      "namespace_id": "7109",
      "simple": { "limit": 20, "period": 60 },
    },
    // Reportes y comentarios: el código usa 8/10min y 5/10min; en CF queda ~1/min.
    { "name": "RATE_LIMIT_REPORT", "namespace_id": "7107", "simple": { "limit": 1, "period": 60 } },
    // Beacons de CSP report, por IP.
    { "name": "RATE_LIMIT_CSP", "namespace_id": "7108", "simple": { "limit": 60, "period": 60 } },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
}
