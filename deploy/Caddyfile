# QuizVerse — TLS + reverse proxy (Caddy, red del host)
# Dominio real: quizverse.org (DNS en Cloudflare, modo "DNS only") → este VPS.
# Los nombres sslip.io se mantienen durante la transición (y la ronda de diseño).

quizverse.org {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3300
}

www.quizverse.org {
	redir https://quizverse.org{uri} permanent
}

api.quizverse.org {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8000
}

# --- Staging (se retira cuando el dominio real esté estable) ---

app.51-79-71-83.sslip.io {
	encode gzip zstd

	# Ronda de diseño (maquetas estáticas) — se retira al implementar
	handle_path /ronda-diseno/* {
		root * /srv/ronda-diseno
		file_server
	}

	reverse_proxy 127.0.0.1:3300
}

api.51-79-71-83.sslip.io {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8000
}

# --- Previews de desarrollo: cualquier puerto publicado con el comando `serve` ---
# Los snippets viven en el host en ~/dev/caddy/ y se montan como /etc/caddy/snippets.
import /etc/caddy/snippets/*.caddy

