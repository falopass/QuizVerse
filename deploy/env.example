# Copiar a deploy/.env EN EL SERVIDOR (nunca commitear).
# Los valores reales viven en el VPS y en .env.local de la máquina de Diego.

NEXT_PUBLIC_SUPABASE_URL=https://api.quizverse.org
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
NEXT_PUBLIC_SITE_URL=https://quizverse.org
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
DEEPSEEK_API_KEY=

# --- SEO ---
# Google Search Console → "Verificar propiedad" → método "Etiqueta HTML":
# pega SOLO el valor de content="..." (sin las comillas).
# Añadirlo requiere `docker compose up -d app` (no hace falta reconstruir).
GOOGLE_SITE_VERIFICATION=

# Alternativa sin tocar el .env: subir a Search Console la URL
# https://quizverse.org/google<token>.html — se sirve automáticamente.
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Handle de X/Twitter (con @) para twitter:site y twitter:creator.
TWITTER_HANDLE=
